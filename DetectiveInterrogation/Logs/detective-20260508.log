ALTER TABLE "Cases" ADD COLUMN IF NOT EXISTS "EndingSuccessText" text;
ALTER TABLE "Cases" ADD COLUMN IF NOT EXISTS "EndingRefusalText" text;
ALTER TABLE "Cases" ADD COLUMN IF NOT EXISTS "EndingDefaultText" text;
