CREATE TABLE IF NOT EXISTS "Achievements" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY,
    "Title" character varying(255) NOT NULL,
    "Description" text,
    CONSTRAINT "PK_Achievements" PRIMARY KEY ("Id")
);

CREATE TABLE IF NOT EXISTS "Cases" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY,
    "Title" character varying(255) NOT NULL,
    "NewspaperText" text,
    "ShortDescription" text,
    "FullDescription" text,
    "EndingSuccessText" text,
    "EndingRefusalText" text,
    "EndingDefaultText" text,
    "CourtImagePath" character varying(500),
    "PrisonImagePath" character varying(500),
    CONSTRAINT "PK_Cases" PRIMARY KEY ("Id")
);

CREATE TABLE IF NOT EXISTS "Users" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY,
    "Username" character varying(50) NOT NULL,
    "Email" character varying(255) NOT NULL,
    "PasswordHash" text NOT NULL,
    "Role" character varying(32) NOT NULL DEFAULT 'Player',
    CONSTRAINT "PK_Users" PRIMARY KEY ("Id")
);

CREATE TABLE IF NOT EXISTS "Evidence" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY,
    "CaseId" integer NOT NULL,
    "SuspectId" character varying(20) NOT NULL,
    "Title" character varying(255) NOT NULL,
    "Description" text NOT NULL,
    CONSTRAINT "PK_Evidence" PRIMARY KEY ("Id"),
    CONSTRAINT "FK_Evidence_Cases_CaseId" FOREIGN KEY ("CaseId") REFERENCES "Cases" ("Id") ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS "Suspects" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY,
    "CaseId" integer NOT NULL,
    "Name" character varying(255) NOT NULL,
    "Description" text,
    "InitialTrust" integer NOT NULL DEFAULT 50,
    "InitialPressure" integer NOT NULL DEFAULT 50,
    "IsGuilty" boolean NOT NULL,
    CONSTRAINT "PK_Suspects" PRIMARY KEY ("Id"),
    CONSTRAINT "FK_Suspects_Cases_CaseId" FOREIGN KEY ("CaseId") REFERENCES "Cases" ("Id") ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS "UserAchievements" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY,
    "UserId" integer NOT NULL,
    "AchievementId" integer NOT NULL,
    CONSTRAINT "PK_UserAchievements" PRIMARY KEY ("Id"),
    CONSTRAINT "FK_UserAchievements_Achievements_AchievementId" FOREIGN KEY ("AchievementId") REFERENCES "Achievements" ("Id") ON DELETE CASCADE,
    CONSTRAINT "FK_UserAchievements_Users_UserId" FOREIGN KEY ("UserId") REFERENCES "Users" ("Id") ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS "EvidencePhrases" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY,
    "EvidenceId" integer NOT NULL,
    "Text" text NOT NULL,
    "TrustChange" integer NOT NULL DEFAULT 0,
    "PressureChange" integer NOT NULL DEFAULT 0,
    CONSTRAINT "PK_EvidencePhrases" PRIMARY KEY ("Id"),
    CONSTRAINT "FK_EvidencePhrases_Evidence_EvidenceId" FOREIGN KEY ("EvidenceId") REFERENCES "Evidence" ("Id") ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS "InterrogationSessions" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY,
    "CaseId" integer NOT NULL,
    "SuspectId" integer NOT NULL,
    "UserId" integer NOT NULL,
    "CurrentTrust" integer NOT NULL DEFAULT 50,
    "CurrentPressure" integer NOT NULL DEFAULT 50,
    "Status" character varying(20) NOT NULL DEFAULT 'InProgress',
    CONSTRAINT "PK_InterrogationSessions" PRIMARY KEY ("Id"),
    CONSTRAINT "FK_InterrogationSessions_Cases_CaseId" FOREIGN KEY ("CaseId") REFERENCES "Cases" ("Id") ON DELETE CASCADE,
    CONSTRAINT "FK_InterrogationSessions_Suspects_SuspectId" FOREIGN KEY ("SuspectId") REFERENCES "Suspects" ("Id") ON DELETE CASCADE,
    CONSTRAINT "FK_InterrogationSessions_Users_UserId" FOREIGN KEY ("UserId") REFERENCES "Users" ("Id") ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS "SuspectReplies" (
    "Id" integer GENERATED BY DEFAULT AS IDENTITY,
