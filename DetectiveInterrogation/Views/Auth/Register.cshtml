@{
    ViewData["Title"] = "Регистрация";
    ViewData["PageClass"] = "auth";
}

<a class="back-link" href="javascript:history.back()" aria-label="Назад">←</a>

<main class="auth-screen">
    <form class="auth-card" data-register-form>
        <h1>Регистрация</h1>
        <label>
            Имя
            <input name="username" autocomplete="username" required minlength="3" />
        </label>
        <label>
            Email
            <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
            Пароль
            <input name="password" type="password" autocomplete="new-password" required minlength="6" />
        </label>
        <button class="primary-action" type="submit">Зарегистрироваться</button>
        <div class="status" data-status></div>
    </form>
</main>
