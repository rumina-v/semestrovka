@{
    ViewData["Title"] = "Админ-панель";
    ViewData["PageClass"] = "admin";
}

<a class="back-link" href="/" aria-label="На главную">←</a>

<main class="admin-screen">
    <section class="admin-card">
        <h1>Админ-панель</h1>
        <button class="primary-action compact" type="button" data-refresh-admin>Обновить</button>
    </section>
    <section class="admin-grid">
        <article class="admin-card">
            <h2>Статистика</h2>
            <div data-admin-stats></div>
        </article>
        <article class="admin-card">
            <h2>Пользователи</h2>
            <div data-admin-users></div>
        </article>
        <article class="admin-card admin-card-wide">
            <h2>Достижения</h2>
            <div data-admin-achievements></div>
        </article>
    </section>
    <div class="status" data-status></div>
</main>
