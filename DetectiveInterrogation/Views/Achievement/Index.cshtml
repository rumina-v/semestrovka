@{
    ViewData["Title"] = "Профиль";
    ViewData["PageClass"] = "profile";
}

<a class="back-link" href="javascript:history.back()" aria-label="Назад">←</a>

<main class="profile-screen" data-profile-page>
    <section class="profile-card">
        <h1>Профиль</h1>
        <div class="profile-fields">
            <div class="profile-field">
                <span>Имя</span>
                <strong data-profile-name>Детектив</strong>
            </div>
            <div class="profile-field">
                <span>Email</span>
                <strong data-profile-email></strong>
            </div>
        </div>
        <h2>Достижения</h2>
        <div class="achievement-list" data-achievements-list></div>
        <button class="secondary-action profile-logout" type="button" data-logout>Выйти</button>
        <div class="status" data-status></div>
    </section>
</main>
